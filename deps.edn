{:paths ["src" "resources"]

 :deps {org.clojure/clojure       {:mvn/version "1.12.0"}
        ;; Motor SQLite (permitido por el enunciado, sección 5.1). Se usa con
        ;; java.sql (JDBC, parte de Java estándar), sin librerías extra. Ver bitácora D-001.
        org.xerial/sqlite-jdbc    {:mvn/version "3.46.1.3"}}

 :aliases
 {;; Ejecutar la CLI:  clojure -M:run traducir "¿Cuándo vendrán ustedes?"
  :run  {:main-opts ["-m" "axios.core"]
         :jvm-opts  ["-Dfile.encoding=UTF-8" "-Dstdout.encoding=UTF-8" "-Dstderr.encoding=UTF-8"
                     "--enable-native-access=ALL-UNNAMED"]}

  :test {:extra-paths ["test"]
         :jvm-opts    ["-Dfile.encoding=UTF-8" "--enable-native-access=ALL-UNNAMED"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test}}}
